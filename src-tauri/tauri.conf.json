{
  "productName": "YTAudioBar",
  "version": "2.6.0-beta.9",
  "identifier": "com.ytaudiobar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1", "librsvg2-common"],
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libappindicator3", "librsvg2"],
        "desktopTemplate": "linux/main.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "./entitlements.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 800, "height": 450 },
        "windowPosition": { "x": 200, "y": 120 },
        "appPosition": { "x": 200, "y": 190 },
        "applicationFolderPosition": { "x": 600, "y": 185 }
      }
    },
    "fileAssociations": [
      { "ext": ["mp3"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/mpeg" },
      { "ext": ["m4a"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-m4a" },
      { "ext": ["m4b"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-m4b" },
      { "ext": ["m4p"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-m4p" },
      { "ext": ["mp4"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/mp4" },
      { "ext": ["flac"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/flac" },
      { "ext": ["ogg"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/ogg" },
      { "ext": ["oga"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/ogg" },
      { "ext": ["opus"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/opus" },
      { "ext": ["spx"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-speex" },
      { "ext": ["wav"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-wav" },
      { "ext": ["aac"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/aac" },
      { "ext": ["webm"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/webm" },
      { "ext": ["weba"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/webm" },
      { "ext": ["wma"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-ms-wma" },
      { "ext": ["ape"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-ape" },
      { "ext": ["wv"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-wavpack" },
      { "ext": ["tta"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-tta" },
      { "ext": ["aiff"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-aiff" },
      { "ext": ["aif"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-aiff" },
      { "ext": ["aifc"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-aiff" },
      { "ext": ["amr"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/amr" },
      { "ext": ["au"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/basic" },
      { "ext": ["caf"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-caf" },
      { "ext": ["mka"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-matroska" },
      { "ext": ["ac3"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/ac3" },
      { "ext": ["dts"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/vnd.dts" },
      { "ext": ["gsm"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-gsm" },
      { "ext": ["voc"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-voc" },
      { "ext": ["3ga"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/3gpp" },
      { "ext": ["dsf"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-dsf" },
      { "ext": ["dff"], "name": "Audio File", "description": "Audio File", "role": "Viewer", "mimeType": "audio/x-dff" }
    ]
  },
  "plugins": {
    "process": {
      "active": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ilyassan/ytaudiobar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQzI5RURBRUU2QzRBOTQKUldTVVNtenUycDdDM29iQ0RubndqcnVsM29EMlBqaG5JSEFOdCtiKzhqRWk3L1hXT3JEU3NuUkQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "YTAudioBar",
        "width": 380,
        "height": 500,
        "minWidth": 380,
        "minHeight": 500,
        "maxWidth": 800,
        "maxHeight": 900,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "center": false,
        "skipTaskbar": false,
        "focus": false,
        "dragDropEnabled": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-hide",
            "core:window:allow-minimize",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-current-monitor",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "shell:default",
            "shell:allow-open",
            "dialog:default",
            "dialog:allow-open",
            "global-shortcut:default",
            "global-shortcut:allow-is-registered",
            "global-shortcut:allow-register",
            "global-shortcut:allow-register-all",
            "global-shortcut:allow-unregister",
            "global-shortcut:allow-unregister-all",
            "updater:default",
            "updater:allow-check",
            "updater:allow-download",
            "updater:allow-install",
            "updater:allow-download-and-install",
            "autostart:default",
            "autostart:allow-enable",
            "autostart:allow-disable",
            "autostart:allow-is-enabled",
            "process:default",
            "process:allow-restart"
          ]
        }
      ]
    }
  }
}
